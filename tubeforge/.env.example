# Google Cloud (read by ADK automatically)
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# ADK — use Vertex AI for all model calls
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Agent model (default: gemini-live-2.5-flash-native-audio)
# DEMO_AGENT_MODEL=gemini-live-2.5-flash-native-audio

# Cloud TTS defaults
TTS_DEFAULT_VOICE=en-US-Neural2-D
TTS_SPEAKING_RATE=0.95

# Cloud Storage bucket for assets
GCS_BUCKET=tubeforge-assets

# Server
PORT=8080
HOST=0.0.0.0

# FFmpeg path (usually auto-detected)
# FFMPEG_PATH=/usr/bin/ffmpeg
